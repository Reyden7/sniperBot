SNIPER_MODE=PAPER
LIVE_TRADING_ENABLED=false
# Utiliser la session deja authentifiee dans MT5. Aucun identifiant ici.
# SNIPER_MT5_PATH=C:\Program Files\MetaTrader 5\terminal64.exe
SNIPER_MT5_TIMEOUT_MS=10000
# Les seuils et conditions broker restent inconnus tant qu'ils ne sont pas verifies.
# SNIPER_BROKER__MAX_SPREAD_POINTS=...
# SNIPER_BROKER__MAX_ROUND_TRIP_COST_PCT=...
# SNIPER_BROKER__ROUND_TRIP_SLIPPAGE_POINTS=...

# Pivot Binance Spot. READ_ONLY est le mode par défaut et aucun endpoint d'ordre
# n'existe dans le premier livrable.
TRADING_MODE=READ_ONLY
LIVE_TRADING_ENABLED=false
# BINANCE_API_KEY=...
# BINANCE_API_SECRET=...
BINANCE_REST_BASE_URL=https://api.binance.com
BINANCE_MARKET_DATA_BASE_URL=https://data-api.binance.vision
BINANCE_WS_BASE_URL=wss://stream.binance.com:9443
BINANCE_FALLBACK_MAKER_FEE_RATE=0.001
BINANCE_FALLBACK_TAKER_FEE_RATE=0.001
BINANCE_SLIPPAGE_BPS_PER_SIDE=1
BINANCE_UNCERTAINTY_BUFFER_BPS=2
